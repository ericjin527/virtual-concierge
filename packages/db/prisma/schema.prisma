// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TonePreset {
  warm
  premium
  efficient
  bilingual
}

enum BookingRequestStatus {
  pending_owner_confirmation
  confirmed
  declined
  needs_callback
  cancelled
}

enum BookingSource {
  phone
  web
  sms
  admin
}

enum SkillsFileStatus {
  draft
  published
  archived
}

enum CallOutcome {
  booking_request_created
  faq_answered
  human_handoff
  callback_created
  abandoned
  spam
  error
}

enum UsageEventType {
  inbound_voice_minute
  realtime_ai_second
  transcription_minute
  text_model_input_token
  text_model_output_token
  sms_segment_sent
  sms_segment_received
  booking_request_created
  human_handoff
}

enum NotificationStatus {
  pending
  sent
  failed
}

// ─── Business & Location ─────────────────────────────────────────────────────

model Business {
  id                String    @id @default(cuid())
  clerkOwnerId      String
  name              String
  publicPhone       String
  ownerPhone        String
  address           String?
  timezone          String    @default("America/Los_Angeles")
  primaryLanguage   String    @default("en")
  secondaryLanguage String?
  tonePreset           TonePreset @default(warm)
  bookingSystem        String     @default("internal")
  bookingSystemConfig  Json?
  active               Boolean    @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  services        Service[]
  therapists      Therapist[]
  rooms           Room[]
  policies        Policy?
  skillsFiles     SkillsFile[]
  bookingRequests BookingRequest[]
  callSessions    CallSession[]
  usageEvents     UsageEvent[]
  customers       Customer[]

  @@index([clerkOwnerId])
}

// ─── Services ────────────────────────────────────────────────────────────────

model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  category        String
  durationMinutes Int
  price           Float
  description     String?
  bestFor         String?
  notBestFor      String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  therapistSkills TherapistSkill[]
  bookingRequests BookingRequest[]

  @@index([businessId])
}

// ─── Therapists ───────────────────────────────────────────────────────────────

model Therapist {
  id         String   @id @default(cuid())
  businessId String
  name       String
  active            Boolean  @default(true)
  languages         String[] @default(["en"])
  gender            String?
  googleCalendarId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  skills       TherapistSkill[]
  shifts       TherapistShift[]
  appointments Appointment[]

  @@index([businessId])
}

model TherapistSkill {
  id           String    @id @default(cuid())
  therapistId  String
  serviceId    String
  createdAt    DateTime  @default(now())

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  service   Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([therapistId, serviceId])
}

model TherapistShift {
  id          String   @id @default(cuid())
  therapistId String
  dayOfWeek   Int?     // 0=Sun, 6=Sat; null if using specific date
  date        DateTime? // specific date override
  startTime   String   // "09:00"
  endTime     String   // "18:00"
  breaks      Json?    // [{ start: "12:00", end: "13:00" }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId])
}

// ─── Rooms ───────────────────────────────────────────────────────────────────

model Room {
  id                   String   @id @default(cuid())
  businessId           String
  name                 String
  compatibleCategories String[]
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([businessId])
}

// ─── Policies ─────────────────────────────────────────────────────────────────

model Policy {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  cancellationPolicy  String?
  lateArrivalPolicy   String?
  parking             String?
  depositPolicy       String?
  refundRule          String?
  medicalDisclaimer   String?
  handoffRules        Json?    // [{ trigger: "...", action: "..." }]
  doNotSayRules       String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ─── Appointments ─────────────────────────────────────────────────────────────

model Appointment {
  id          String   @id @default(cuid())
  businessId  String
  therapistId String
  roomId      String?
  customerId  String?
  startTime   DateTime
  endTime     DateTime
  notes       String?
  cancelled   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  therapist Therapist  @relation(fields: [therapistId], references: [id])
  room      Room?      @relation(fields: [roomId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id])

  @@index([therapistId, startTime])
  @@index([businessId, startTime])
}

// ─── Customers ───────────────────────────────────────────────────────────────

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String
  language   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingRequests BookingRequest[]
  appointments    Appointment[]

  @@unique([businessId, phone])
  @@index([businessId])
}

// ─── Booking Requests ─────────────────────────────────────────────────────────

model BookingRequest {
  id                   String               @id @default(cuid())
  businessId           String
  customerId           String?
  serviceId            String?
  customerName         String
  customerPhone        String
  requestedDate        String               // "2026-05-01"
  preferredSlot        String?              // "17:00"
  recommendedSlotsJson Json?
  notes                String?
  source               BookingSource        @default(web)
  status               BookingRequestStatus @default(pending_owner_confirmation)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id])
  service  Service?  @relation(fields: [serviceId], references: [id])

  @@index([businessId, status])
}

// ─── Skills Files ─────────────────────────────────────────────────────────────

model SkillsFile {
  id         String           @id @default(cuid())
  businessId String
  version    Int              @default(1)
  status     SkillsFileStatus @default(draft)
  content    Json             // the skills YAML/JSON structure
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tests    SkillsTest[]

  @@index([businessId, status])
}

model SkillsTest {
  id           String   @id @default(cuid())
  skillsFileId String
  scenario     String
  input        String
  expectedBehavior String
  passed       Boolean?
  result       String?
  runAt        DateTime?
  createdAt    DateTime @default(now())

  skillsFile SkillsFile @relation(fields: [skillsFileId], references: [id], onDelete: Cascade)
}

// ─── Call Sessions ────────────────────────────────────────────────────────────

model CallSession {
  id              String      @id @default(cuid())
  businessId      String
  twilioCallSid   String      @unique
  callerPhone     String?
  startedAt       DateTime    @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  outcome         CallOutcome?
  transcriptJson  Json?
  createdAt       DateTime    @default(now())

  business      Business      @relation(fields: [businessId], references: [id])
  conversations Conversation[]
  usageEvents   UsageEvent[]

  @@index([businessId])
}

model Conversation {
  id            String   @id @default(cuid())
  callSessionId String?
  businessId    String
  channel       String   // phone | web | sms
  messagesJson  Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  callSession CallSession? @relation(fields: [callSessionId], references: [id])

  @@index([businessId])
}

// ─── Usage Events ─────────────────────────────────────────────────────────────

model UsageEvent {
  id            String         @id @default(cuid())
  businessId    String
  callSessionId String?
  eventType     UsageEventType
  quantity      Float          @default(1)
  unitCostUsd   Float?
  metadata      Json?
  createdAt     DateTime       @default(now())

  business    Business     @relation(fields: [businessId], references: [id])
  callSession CallSession? @relation(fields: [callSessionId], references: [id])

  @@index([businessId, createdAt])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id         String             @id @default(cuid())
  businessId String
  toPhone    String
  body       String
  status     NotificationStatus @default(pending)
  twilioSid  String?
  createdAt  DateTime           @default(now())
  sentAt     DateTime?

  @@index([businessId])
}

// ─── Local Butler Network ─────────────────────────────────────────────────────

enum ExpertCategory {
  driver
  restaurant_expert
  errand_helper
  local_guide
  photographer
  private_chef
  cleaner
  florist
  family_helper
  party_helper
  // legacy values kept for DB compatibility
  appliance_repair
  event_booking
  parenting_logistics
}

enum IntakeMode {
  full_delegation
  specific_services
}

enum ExperienceType {
  hosting
  local_visit
}

enum ExperienceStatus {
  intake
  plan_ready
  in_coordination
  confirmed
  in_progress
  completed
  cancelled
}

enum ExpertStatus {
  pending
  approved
  suspended
}

enum TaskStatus {
  new
  matched
  accepted
  diagnosing
  quote_submitted
  quote_approved
  in_progress
  completed
  cancelled
  declined
}

enum TaskSource {
  web
  phone
  sms
}

enum QuoteStatus {
  pending
  approved
  declined
}

enum MessageRole {
  customer
  expert
  admin
  butler
}

// ─── Glam Vertical Enums ─────────────────────────────────────────────────────

enum GlamExpertCategory {
  photographer
  makeup_artist
  hair_stylist
  wardrobe_stylist
  rental_partner
  cultural_outfit_partner
  photo_editor
  video_creator
  local_coordinator
  transport_partner
}

enum GlamTaskCategory {
  photography
  makeup
  hair
  styling
  wardrobe_rental
  cultural_outfit
  creative_direction
  photo_editing
  video_reel
  location_scouting
  transport
  concierge_support
}

enum DestinationStatus {
  draft
  active
  paused
}

enum ProposalStatus {
  invited
  accepted
  declined
  selected
  rejected
}

enum PackageOptionStatus {
  draft
  presented
  selected
  rejected
}

model Expert {
  id                  String           @id @default(cuid())
  clerkUserId         String?          @unique
  name                String
  businessName        String?
  email               String           @unique
  phone               String
  bio                 String?
  photoUrl            String?
  category            ExpertCategory
  categories          ExpertCategory[] @default([])
  serviceArea         String
  cities              String[]         @default([])
  services            String[]
  specialties         String[]
  certifications      String[]
  insuranceVerified   Boolean          @default(false)
  backgroundChecked   Boolean          @default(false)
  isVerified          Boolean          @default(false)
  isAvailable         Boolean          @default(true)
  diagnosticFee       Float?
  languages           String[]         @default(["en"])
  rating              Float?
  completedJobs       Int              @default(0)
  responseTimeMinutes Int?
  maxConcurrentJobs   Int              @default(2)
  status              ExpertStatus     @default(pending)
  badges              String[]
  glamCategory        GlamExpertCategory?
  destinationIds      String[]         @default([])
  areaIds             String[]         @default([])
  metadata            Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  tasks     Task[]
  quotes    TaskQuote[]
  bookings  TaskBooking[]
  reviews   ExpertReview[]
  proposals ExpertProposal[]

  @@index([category, status])
  @@index([glamCategory, status])
  @@index([serviceArea])
}

model VendorApplication {
  id              String         @id @default(cuid())
  name            String
  businessName    String?
  email           String
  phone           String
  category        ExpertCategory
  serviceArea     String
  services        String[]
  certDocUrls     String[]
  insuranceDocUrl String?
  notes           String?
  status          ExpertStatus   @default(pending)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
}

model Lead {
  id          String   @id @default(cuid())
  name        String?
  phone       String?
  email       String?
  clerkUserId String?
  createdAt   DateTime @default(now())

  tasks       Task[]
  experiences Experience[]

  @@index([clerkUserId])
}

model Task {
  id           String         @id @default(cuid())
  leadId       String?
  expertId     String?
  experienceId String?
  category     ExpertCategory
  intakeBrief  Json
  address      String?
  urgency      String?
  status       TaskStatus     @default(new)
  source       TaskSource     @default(web)
  claimedAt     DateTime?
  completedAt   DateTime?
  cancelReason  String?
  deliverable   Json?
  glamCategory  GlamTaskCategory?
  destinationId String?
  dueAt         DateTime?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  lead        Lead?          @relation(fields: [leadId], references: [id])
  expert      Expert?        @relation(fields: [expertId], references: [id])
  experience  Experience?    @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  destination Destination?   @relation(fields: [destinationId], references: [id])
  quotes      TaskQuote[]
  booking     TaskBooking?
  reviews     ExpertReview[]
  messages    TaskMessage[]
  proposals   ExpertProposal[]

  @@index([status])
  @@index([expertId])
  @@index([category, status])
  @@index([glamCategory, status])
  @@index([experienceId])
  @@index([destinationId])
}

model Experience {
  id               String           @id @default(cuid())
  type             ExperienceType
  leadId           String?
  intakeMode       IntakeMode?
  selectedServices String[]         @default([])
  intakePayload    Json?
  city             String?
  dates            String?
  startDate        String?
  endDate          String?
  occasion         String?
  travelers        Int              @default(1)
  vibe             String?
  budget           String?
  hotelBase        String?
  planDraft        Json?
  aiBrief          Json             @default("{}")
  destinationId    String?
  metadata         Json?
  status           ExperienceStatus @default(intake)
  confirmedAt      DateTime?
  summaryEmail     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  lead           Lead?           @relation(fields: [leadId], references: [id])
  destination    Destination?    @relation(fields: [destinationId], references: [id])
  tasks          Task[]
  packageOptions PackageOption[]

  @@index([type, status])
  @@index([status])
  @@index([destinationId])
}

model TaskQuote {
  id          String      @id @default(cuid())
  taskId      String
  expertId    String
  amount      Float
  description String
  status      QuoteStatus @default(pending)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  expert Expert @relation(fields: [expertId], references: [id])

  @@index([taskId])
}

model TaskBooking {
  id          String    @id @default(cuid())
  taskId      String    @unique
  expertId    String
  scheduledAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  expert Expert @relation(fields: [expertId], references: [id])
}

model ExpertReview {
  id        String   @id @default(cuid())
  taskId    String
  expertId  String
  rating    Int
  body      String?
  createdAt DateTime @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  expert Expert @relation(fields: [expertId], references: [id])

  @@index([expertId])
}

model TaskMessage {
  id        String      @id @default(cuid())
  taskId    String
  fromRole  MessageRole
  body      String
  createdAt DateTime    @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ─── Glam Vertical Models ────────────────────────────────────────────────────

model Destination {
  id        String            @id @default(cuid())
  name      String
  country   String
  timezone  String
  currency  String
  languages String[]          @default([])
  status    DestinationStatus @default(draft)
  metadata  Json?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  areas       DestinationArea[]
  experiences Experience[]
  tasks       Task[]

  @@index([status])
  @@index([country])
}

model DestinationArea {
  id            String   @id @default(cuid())
  destinationId String
  name          String
  tags          String[] @default([])
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
}

model ExpertProposal {
  id                 String         @id @default(cuid())
  taskId             String
  expertId           String
  status             ProposalStatus @default(invited)
  proposedPrice      Float?
  currency           String?
  note               String?
  portfolioSampleUrl String?
  availableStart     DateTime?
  availableEnd       DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  expert Expert @relation(fields: [expertId], references: [id])

  @@unique([taskId, expertId])
  @@index([taskId, status])
  @@index([expertId, status])
}

model PackageOption {
  id              String              @id @default(cuid())
  experienceId    String
  title           String
  description     String?
  price           Float
  currency        String
  status          PackageOptionStatus @default(draft)
  includedTaskIds String[]            @default([])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  experience Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, status])
}
